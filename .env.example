# WSO2 Identity Server issuer must exactly match the JWT iss claim.
# Configure the hostname so the gateway container can resolve and trust it.
WSO2_ISSUER_URI=https://host.docker.internal:9443/oauth2/token

# Standard WSO2 IS JWKS endpoint; override only for a custom deployment path.
WSO2_JWKS_URI=https://host.docker.internal:9443/oauth2/jwks

# Optional. When set, access tokens must contain this value in their aud claim.
WSO2_REQUIRED_AUDIENCE=

# Optional JVM TLS truststore flags, supplied by your local secret/mount setup.
# Example: -Djavax.net.ssl.trustStore=/run/secrets/wso2-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12
JAVA_TOOL_OPTIONS=

# Leave unset in production. Enables GET /api/console/token and /jwks for a local demo.
LOCAL_DEV_TOKENS=false
ORDERS_RATE_LIMIT_REPLENISH=20
ORDERS_RATE_LIMIT_BURST=40
CUSTOMERS_RATE_LIMIT_REPLENISH=30
CUSTOMERS_RATE_LIMIT_BURST=60
