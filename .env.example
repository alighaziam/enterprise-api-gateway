# WSO2 Identity Server issuer must exactly match the JWT iss claim.
# Configure the hostname so the gateway container can resolve and trust it.
WSO2_ISSUER_URI=https://host.docker.internal:9443/oauth2/token

# Optional. When set, access tokens must contain this value in their aud claim.
WSO2_REQUIRED_AUDIENCE=

# Redis and backend endpoints are provided by docker-compose for local use.
ORDERS_RATE_LIMIT_REPLENISH=20
ORDERS_RATE_LIMIT_BURST=40
CUSTOMERS_RATE_LIMIT_REPLENISH=30
CUSTOMERS_RATE_LIMIT_BURST=60
